---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicBadge from '../components/TopicBadge.astro';
import ActionLink from '../components/ActionLink.astro';
import { concerns } from '../data/concerns';
import { popularClaims } from '../data/popularClaims';
import { claims, assessmentLabels } from '../data/claims';
import { conversationMvpClaims } from '../data/conversationMvp';
import { claimIndexEntries } from '../data/claimIndexData';
const featuredConcerns = concerns.filter((item) => ['vivienda','inmigracion','empleo','politica','sanidad'].includes(item.slug));
const publishedClaimCount = claims.filter((item) => item.published).length;
const latestPublishedClaims = claims.filter((item) => item.published).sort((a, b) => b.reviewed.localeCompare(a.reviewed)).slice(0, 4);
const featuredConversationSlugs = [
  'inmigracion-delincuencia',
  'inmigrantes-ayudas',
  'viviendas-vacias',
  'empleo-record',
  'smi-destruye-empleo',
  'empleo-creado-es-solo-tiempo-parcial',
  'la-mayoria-del-empleo-es-temporal',
  'espana-cobra-igual-por-hora-que-europa',
  'espana-sobrecarga-vivienda-europa',
  'espana-impuestos-europa',
  'sanidad-colapsada',
  'espana-mas-peligrosa',
  'paro-juvenil-espana-ue',
];
const featuredConversation = featuredConversationSlugs
  .map((slug) => conversationMvpClaims.find((item) => item.slug === slug))
  .filter((item): item is (typeof conversationMvpClaims)[number] => Boolean(item));
const remainingConversation = conversationMvpClaims.filter((item) => !featuredConversationSlugs.includes(item.slug));
const checkerPrompts = [...featuredConversation, ...remainingConversation];
const warehousePrompts = [
  '¿Cómo ha cambiado el precio de la luz para los hogares?',
  '¿Cuál es el tamaño de la economía española?',
  '¿Cómo han cambiado los alquileres en España?',
  '¿Cuál es la inflación anual en España?',
  '¿Está la inflación de España por encima de la Unión Europea?',
  '¿Cómo ha evolucionado la desigualdad de ingresos en España?',
  '¿Cómo ha cambiado el déficit público sobre el PIB?',
  '¿Cómo ha evolucionado la renta mediana de los hogares?',
  '¿Ha bajado la desigualdad de renta en España?',
  '¿Sigue creciendo el PIB real de España?',
  '¿Crece España más que la Unión Europea?',
  '¿Tiene España más PIB por habitante que la Unión Europea?',
  '¿Cómo ha cambiado el salario mínimo en España?',
  '¿Cuánto gasta España en prestaciones de protección social por habitante?',
  '¿Cuánto gasta España en pensiones y prestaciones de supervivencia por habitante?',
  '¿España gasta más por habitante en pensiones que la Unión Europea?',
  '¿España cobra más impuestos sobre renta y riqueza que la Unión Europea?',
  '¿Qué porcentaje de hogares sufre sobrecarga de vivienda?',
  '¿Qué porcentaje de personas está en riesgo de pobreza o exclusión?',
  '¿España gasta más por habitante en sanidad?',
  '¿España gasta más por habitante en sanidad que la Unión Europea?',
  '¿Cuánto gasta España en sanidad por habitante?',
  '¿Cómo ha evolucionado la esperanza de vida en España?',
  '¿Cómo ha cambiado la fecundidad en España?',
  '¿Cómo ha evolucionado el envejecimiento de la población española?',
  '¿Qué porcentaje de la población tiene 65 años o más?',
  '¿Qué porcentaje de la población tiene menos de 15 años?',
  '¿España está perdiendo población?',
  '¿Qué porcentaje de la población activa encuentra trabajo?',
  '¿Cómo ha evolucionado el desempleo en España?',
  '¿Tiene España una tasa de empleo mayor que la Unión Europea?',
  '¿Qué parte del empleo en España es a tiempo parcial?',
  '¿España tiene más empleo parcial que la Unión Europea?',
  '¿Qué parte del empleo en España es temporal?',
  '¿España tiene más temporalidad que Europa?',
  '¿Cuál es el salario mediano por hora en España?',
  '¿España cobra menos por hora que Europa?',
  '¿España tiene más sobrecarga de vivienda que Europa?',
  '¿Cuántos habitantes viven normalmente en España?',
  '¿Cuántos residentes nacieron fuera de España?',
  '¿Cuántos residentes tienen ciudadanía extranjera en España?',
  '¿Cuántas personas inmigraron a España durante el último año?',
  '¿Cómo han evolucionado los homicidios registrados en España?',
  '¿Cómo han evolucionado los robos registrados en España?',
  '¿Cómo han evolucionado las estafas registradas en España?',
  '¿Cómo han evolucionado las agresiones sexuales registradas en España?',
  '¿Qué comunidad tiene mayor densidad de población?',
  '¿Madrid tiene más densidad que Andalucía?',
  '¿Cómo ha evolucionado la deuda pública española sobre el PIB?',
  '¿Qué porcentaje de jóvenes activos no encuentra trabajo?',
  '¿Tiene España más paro juvenil que la Unión Europea?',
  '¿Cuánto debe España?',
  '¿Cuánto dinero se dedica por persona a la sanidad?',
  '¿Cuánto ingresan de media los hogares?',
  '¿Cómo ha evolucionado la fecundidad en España?',
  '¿Cómo ha evolucionado la desigualdad de ingresos en España?',
  '¿España recauda más o menos que la media europea?',
  '¿España gasta más o menos que la media de la Unión Europea?',
  '¿Cuánto gasta el sector público sobre el PIB?',
  '¿Cómo ha cambiado el PIB medido en euros corrientes?',
  '¿Cuál es el coeficiente de Gini de España?',
  '¿Cómo ha cambiado el precio de la electricidad para los hogares?',
  '¿Cuánto ingresan de media los hogares en España?',
  '¿España tiene más renta mediana que la Unión Europea?',
  '¿Qué porcentaje de personas mayores depende de la población en edad de trabajar?',
  '¿Cómo ha evolucionado el abandono escolar temprano en España?',
  '¿Qué porcentaje de jóvenes de 25 a 34 años tiene estudios superiores?',
  '¿Qué porcentaje de jóvenes ni estudia ni trabaja en España?',
  '¿Ha aumentado la falta de atención médica por listas de espera?',
  '¿Cómo ha cambiado el PIB por habitante en España?',
  '¿Cuánto debe España en euros?',
];
const warehouseHighlights = [
  { label: 'Coste de vida', prompt: '¿Cuál es la inflación anual en España?', detail: 'Precios recientes y evolución anual.' },
  { label: 'Coste de vida · Europa', prompt: '¿Está la inflación de España por encima de la Unión Europea?', detail: 'Misma tasa armonizada, periodo y metodología para comparar los precios.' },
  { label: 'Economía', prompt: '¿Cuál es el tamaño de la economía española?', detail: 'PIB a precios corrientes, separado del crecimiento real.' },
  { label: 'Economía · Europa', prompt: '¿Crece España más que la Unión Europea?', detail: 'Mismo indicador, periodo y metodología para comparar el PIB real.' },
  { label: 'Economía por habitante · Europa', prompt: '¿Tiene España más PIB por habitante que la Unión Europea?', detail: 'PIB por habitante expresado en poder adquisitivo; no es la renta disponible de los hogares.' },
  { label: 'Empleo · salario mínimo', prompt: '¿Cómo ha cambiado el salario mínimo en España?', detail: 'Salario mínimo legal mensual; no equivale al salario medio ni a la renta de cada hogar.' },
  { label: 'Finanzas públicas · ayudas', prompt: '¿Cuánto gasta España en prestaciones de protección social por habitante?', detail: 'Gasto agregado en prestaciones sociales; no mide quién recibe cada ayuda ni sus requisitos.' },
  { label: 'Finanzas públicas · pensiones', prompt: '¿Cuánto gasta España en pensiones y prestaciones de supervivencia por habitante?', detail: 'Gasto en vejez y supervivencia; no equivale a la pensión media ni demuestra por sí solo su sostenibilidad.' },
  { label: 'Finanzas públicas · pensiones · Europa', prompt: '¿España gasta más por habitante en pensiones que la Unión Europea?', detail: 'Mismo gasto en vejez y supervivencia por habitante y año común; no equivale a la pensión media.' },
  { label: 'Impuestos · Europa', prompt: '¿España cobra más impuestos sobre renta y riqueza que la Unión Europea?', detail: 'Impuestos corrientes sobre renta y riqueza como porcentaje del PIB; no es la factura fiscal de un hogar.' },
  { label: 'Vivienda', prompt: '¿Cómo han cambiado los alquileres en España?', detail: 'Una serie para separar sensación y tendencia.' },
  { label: 'Empleo', prompt: '¿Cómo ha evolucionado el desempleo en España?', detail: 'La medida y el periodo aparecen junto al dato.' },
  { label: 'Empleo · Europa', prompt: '¿Tiene España una tasa de empleo mayor que la Unión Europea?', detail: 'Misma población de 20 a 64 años y definición comparable.' },
  { label: 'Empleo · jornada', prompt: '¿Qué parte del empleo en España es a tiempo parcial?', detail: 'Porcentaje de personas ocupadas de 15 a 64 años con empleo parcial; no demuestra por sí solo que los empleos nuevos sean parciales.' },
  { label: 'Empleo · jornada · Europa', prompt: '¿España tiene más empleo parcial que la Unión Europea?', detail: 'Misma medida, edad y denominador para comparar la jornada parcial en España y la UE.' },
  { label: 'Empleo · temporalidad', prompt: '¿Qué parte del empleo en España es temporal?', detail: 'Proporción de empleados de 15 a 64 años con contrato temporal; no equivale por sí sola a precariedad o bajos salarios.' },
  { label: 'Empleo · temporalidad · Europa', prompt: '¿España tiene más temporalidad que Europa?', detail: 'Misma medida, edad y denominador para comparar la temporalidad en España y la UE.' },
  { label: 'Empleo · salario por hora', prompt: '¿Cuál es el salario mediano por hora en España?', detail: 'Ganancia bruta mediana por hora en empresas de diez o más personas; última observación comparable: 2022.' },
  { label: 'Empleo · salario por hora · Europa', prompt: '¿España cobra menos por hora que Europa?', detail: 'Misma mediana bruta por hora y año común; no es salario neto, salario mínimo ni renta del hogar.' },
  { label: 'Vivienda · esfuerzo · Europa', prompt: '¿España tiene más sobrecarga de vivienda que Europa?', detail: 'Costes totales de vivienda por encima del 40% de la renta disponible equivalente; la última comparación es de 2025.' },
  { label: 'Empleo juvenil · Europa', prompt: '¿Tiene España más paro juvenil que la Unión Europea?', detail: 'Misma población activa de 15 a 24 años y tasa comparable.' },
  { label: 'Población', prompt: '¿Cuántos habitantes viven normalmente en España?', detail: 'Población residente y cambio en el tiempo.' },
  { label: 'Inmigración · nacionalidad', prompt: '¿Cuántos residentes tienen ciudadanía extranjera en España?', detail: 'Nacionalidad y país de nacimiento son medidas distintas; tampoco equivale a llegadas anuales.' },
  { label: 'Sanidad', prompt: '¿Cuánto dinero se dedica por persona a la sanidad?', detail: 'Gasto comparable, unidad y fuente.' },
  { label: 'Sanidad · Europa', prompt: '¿España gasta más por habitante en sanidad que la Unión Europea?', detail: 'Mismo gasto corriente por habitante y año común; no es una medida directa de calidad.' },
  { label: 'Seguridad', prompt: '¿Cómo han evolucionado los homicidios registrados en España?', detail: 'La categoría exacta, no una etiqueta genérica de “crimen”.' },
  { label: 'Seguridad digital', prompt: '¿Cómo han evolucionado las estafas registradas en España?', detail: 'Fraude registrado como categoría propia, no como percepción de inseguridad.' },
  { label: 'Seguridad', prompt: '¿Cómo han evolucionado los robos registrados en España?', detail: 'Robos con violencia separados de hurtos y del total de delitos.' },
  { label: 'Territorio', prompt: '¿Madrid tiene más densidad que Andalucía?', detail: 'Compara dos comunidades con el mismo indicador y periodo.' },
  { label: 'Deuda pública · ratio', prompt: '¿Qué porcentaje del PIB representa la deuda pública de España?', detail: 'Deuda consolidada expresada sobre el PIB; no es el importe total en euros.' },
  { label: 'Deuda pública · euros', prompt: '¿Cuánto debe España en euros?', detail: 'Importe nominal de la deuda consolidada; no es lo mismo que su ratio sobre el PIB.' },
  { label: 'Juventud', prompt: '¿Qué porcentaje de jóvenes activos no encuentra trabajo?', detail: 'Desempleo de 15 a 24 años, separado del paro general.' },
  { label: 'Demografía', prompt: '¿Cómo ha evolucionado la fecundidad en España?', detail: 'Hijos por mujer y evolución temporal.' },
  { label: 'Desigualdad', prompt: '¿Cómo ha evolucionado la desigualdad de ingresos en España?', detail: 'Coeficiente de Gini y límites de lo que resume.' },
  { label: 'Ingresos públicos', prompt: '¿España recauda más o menos que la media europea?', detail: 'Ingresos públicos sobre el PIB, con países y año comparables.' },
  { label: 'Ingresos públicos · Europa', prompt: '¿España recauda más o menos que la media de la Unión Europea?', detail: 'Mismo agregado público, año y porcentaje del PIB para comparar.' },
  { label: 'Gasto público', prompt: '¿Cuánto gasta el sector público sobre el PIB?', detail: 'Gasto agregado separado de la factura de cada hogar.' },
  { label: 'Gasto público · Europa', prompt: '¿España gasta más o menos que la media de la Unión Europea?', detail: 'Mismo agregado público, año y porcentaje del PIB para comparar.' },
  { label: 'Renta', prompt: '¿Cuánto ingresan de media los hogares en España?', detail: 'Renta mediana equivalente, no una media que oculte la distribución.' },
  { label: 'Renta · Europa', prompt: '¿España tiene más renta mediana que la Unión Europea?', detail: 'Misma mediana expresada en poder adquisitivo; no es salario medio ni PIB por habitante.' },
  { label: 'Envejecimiento', prompt: '¿Qué porcentaje de personas mayores depende de la población en edad de trabajar?', detail: 'Dependencia demográfica y límites de una proporción agregada.' },
  { label: 'Educación', prompt: '¿Cómo ha evolucionado el abandono escolar temprano en España?', detail: 'Personas de 18 a 24 años y una definición explícita.' },
  { label: 'Educación superior', prompt: '¿Qué porcentaje de jóvenes de 25 a 34 años tiene estudios superiores?', detail: 'Titulación superior separada del empleo y del abandono escolar.' },
  { label: 'Juventud', prompt: '¿Qué porcentaje de jóvenes ni estudia ni trabaja en España?', detail: 'Personas de 15 a 29 años fuera del empleo y de la educación o formación.' },
  { label: 'Acceso sanitario', prompt: '¿Ha aumentado la falta de atención médica por listas de espera?', detail: 'Necesidad médica no atendida declarada, separada de las listas quirúrgicas.' },
];
const conversationPayload = JSON.stringify(conversationMvpClaims).replace(/</g, '\\u003c');
const claimIndexPayload = JSON.stringify(claimIndexEntries).replace(/</g, '\\u003c');
---
<BaseLayout description="Comprueba afirmaciones sobre España con datos públicos, contexto y fuentes originales.">
  <section class="homepage-hero" id="comprobar">
    <div class="hero-layout">
      <div class="hero-copy-block"><p class="eyebrow">Comprobar una afirmación</p><h1>¿De qué estáis<br /><em>discutiendo?</em></h1><p class="hero-dek">Pega una frase, un titular o un mensaje que esté circulando. Lo convertimos en una comprobación breve, comprensible y fácil de compartir.</p><ul class="hero-promises" aria-label="Qué encontrarás"><li><span>01</span>Qué parte está respaldada</li><li><span>02</span>Qué no demuestra el dato</li><li><span>03</span>Qué preguntar después</li></ul></div>
      <div class="hero-checker">
        <div class="checker-heading"><p class="eyebrow">Empieza aquí</p><span>Texto · enlace · captura · audio</span></div>
        <form class="conversation-form" id="conversation-form" role="search"><label for="conversation-input">Pega lo que se ha dicho</label><div class="conversation-input-wrap"><textarea id="conversation-input" name="q" rows="3" maxlength="1200" autocomplete="off" placeholder="“Los inmigrantes crean inseguridad…”" aria-describedby="conversation-help"></textarea><button type="submit">Comprobar <span aria-hidden="true">→</span></button></div><p id="conversation-help" class="conversation-help"><span>Escríbelo como lo has oído: puede ser brusco, incompleto o confuso. No hace falta que sea preciso ni académico.</span><span id="conversation-counter" aria-live="polite">0/1200</span></p><label class="conversation-media" data-media-dropzone for="conversation-file"><span data-file-name>Añadir captura o audio</span><input id="conversation-file" name="file" type="file" accept="image/*,audio/*" /></label><p id="conversation-media-help" class="conversation-media-help" aria-live="polite">También puedes arrastrar o pegar una captura; se enviará automáticamente.</p></form>
        <div class="conversation-examples" aria-label="Afirmaciones frecuentes"><div class="examples-heading"><span>Prueba una conversación frecuente</span><a href="/afirmaciones">Ver todas <span aria-hidden="true">→</span></a></div><div class="example-filters" role="group" aria-label="Filtrar afirmaciones frecuentes"><button type="button" class="example-filter is-selected" data-example-filter="all" aria-pressed="true">Todas</button><button type="button" class="example-filter" data-example-filter="vivienda" aria-pressed="false">Vivienda</button><button type="button" class="example-filter" data-example-filter="empleo" aria-pressed="false">Empleo</button><button type="button" class="example-filter" data-example-filter="inmigracion" aria-pressed="false">Inmigración</button><button type="button" class="example-filter" data-example-filter="seguridad" aria-pressed="false">Seguridad</button><button type="button" class="example-filter" data-example-filter="economia" aria-pressed="false">Economía</button><button type="button" class="example-filter" data-example-filter="sanidad" aria-pressed="false">Sanidad</button><button type="button" class="example-filter" data-example-filter="impuestos" aria-pressed="false">Impuestos</button><button type="button" class="example-filter" data-example-filter="desigualdad" aria-pressed="false">Desigualdad</button></div><div class="example-prompts">{checkerPrompts.map((item, index) => <button type="button" data-example={item.prompt} data-example-topic={item.topicSlug} hidden={index >= 8}>{item.prompt}</button>)}</div><button type="button" class="example-more" data-example-more aria-expanded="false">Ver más afirmaciones <span aria-hidden="true">＋</span></button><details class="warehouse-prompts"><summary><span>Más preguntas con datos actualizados</span><small>Indicadores recientes · {warehousePrompts.length} ejemplos</small><b aria-hidden="true">＋</b></summary><div>{warehousePrompts.map((prompt) => <button type="button" data-example={prompt} data-example-source="warehouse">{prompt}</button>)}</div></details></div>
        <div class="conversation-result" id="conversation-result" aria-live="polite"></div>
        <noscript><p class="conversation-noscript">Activa JavaScript para escribir una afirmación. También puedes empezar por <a href="/afirmaciones">las afirmaciones publicadas</a>.</p></noscript>
      </div>
    </div>
  </section>
  <section id="afirmaciones" class="popular-home"><header class="section-header section-header-split"><div><p class="eyebrow">Preguntas que aparecen cada día</p><h2>Lo que se está<br /><em>discutiendo.</em></h2></div><p class="section-header-description">Hay {publishedClaimCount} afirmaciones publicadas. Empieza por una pregunta frecuente o escribe la tuya arriba; cada respuesta distingue datos, límites y contexto.</p></header><div class="popular-grid">{popularClaims.slice(0, 8).map((item) => <a class="popular-card" href={`/afirmaciones/${item.slug}`}><div class="popular-card-meta"><TopicBadge slug={item.topicSlug} compact /><span class={`popular-assessment popular-assessment-${item.assessment}`} data-assessment={item.assessment}>{assessmentLabels[item.assessment]}</span></div><h3>{item.claim.replace(/[“”]/g,'')}</h3><span class="card-arrow">Ver datos <span aria-hidden="true">→</span></span></a>)}</div><div id="dynamic-popular-claims" class="dynamic-popular" hidden aria-live="polite"></div><ActionLink href="/afirmaciones" label={`Ver las ${publishedClaimCount} afirmaciones publicadas`} /></section>
  <section class="latest-home" aria-labelledby="latest-home-title"><header class="section-header section-header-split"><div><p class="eyebrow">Actualizado recientemente</p><h2 id="latest-home-title">Lo último que<br /><em>hemos comprobado.</em></h2></div><p class="section-header-description">Las comprobaciones más recientes aparecen aquí automáticamente cuando añadimos una fuente y una explicación revisada. No tienes que esperar a que se conviertan en una pregunta popular.</p></header><div class="latest-grid">{latestPublishedClaims.map((item) => <a class="latest-card" data-latest-claim={item.slug} href={`/afirmaciones/${item.slug}`}><div class="latest-card-meta"><TopicBadge slug={item.topicSlug} compact /><span class={`popular-assessment popular-assessment-${item.assessment}`} data-assessment={item.assessment}>{assessmentLabels[item.assessment]}</span><time datetime={item.reviewed}>{new Date(item.reviewed).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time></div><h3>{item.claim.replace(/[“”]/g,'')}</h3><span class="card-arrow">Abrir comprobación <span aria-hidden="true">→</span></span></a>)}</div></section>
  <section class="warehouse-home" aria-labelledby="warehouse-home-title"><header class="section-header section-header-split"><div><p class="eyebrow">Indicadores con datos recientes</p><h2 id="warehouse-home-title">Preguntas que<br /><em>puedes hacer ya.</em></h2></div><p class="section-header-description">No necesitas esperar a que una frase se convierta en una ficha. Estas preguntas activan directamente nuestras series de datos y muestran la unidad, el periodo y la fuente.</p></header><div class="warehouse-highlight-grid">{warehouseHighlights.slice(0, 6).map((item) => <button type="button" class="warehouse-highlight" data-example={item.prompt} data-example-source="warehouse"><span>{item.label}</span><h3>{item.prompt}</h3><p>{item.detail}</p><strong>Preguntar <b aria-hidden="true">→</b></strong></button>)}{warehouseHighlights.length > 6 && <details class="warehouse-more"><summary><span>Ver más indicadores</span><small>{warehouseHighlights.length - 6} preguntas sobre vivienda, demografía, educación, salud y economía</small><b aria-hidden="true">＋</b></summary><div class="warehouse-more-grid">{warehouseHighlights.slice(6).map((item) => <button type="button" class="warehouse-highlight" data-example={item.prompt} data-example-source="warehouse"><span>{item.label}</span><h3>{item.prompt}</h3><p>{item.detail}</p><strong>Preguntar <b aria-hidden="true">→</b></strong></button>)}</div></details>}</div><p class="warehouse-home-more"><a href="#comprobar">Escribe una pregunta distinta <span aria-hidden="true">↗</span></a><span>Hay {warehousePrompts.length} ejemplos de indicadores en el comprobador.</span></p></section>
  <section class="home-how" aria-labelledby="home-how-title"><div><p class="eyebrow">Cómo funciona</p><h2 id="home-how-title">Una respuesta útil<br /><em>en tres pasos.</em></h2></div><ol><li><span>01</span><strong>Separamos la frase</strong><p>Distinguimos hechos, causas, opiniones y lo que todavía es demasiado ambiguo.</p></li><li><span>02</span><strong>Buscamos el dato adecuado</strong><p>La fuente, la fecha, el lugar y la población van unidos a cada cifra.</p></li><li><span>03</span><strong>Te damos una forma de decirlo</strong><p>Una respuesta breve para la conversación y un camino claro hacia las fuentes.</p></li></ol></section>
  <section id="temas" class="topics-home"><header class="section-header section-header-split"><div><p class="eyebrow">Investigaciones en profundidad</p><h2>Los problemas<br /><em>de fondo.</em></h2></div><p class="section-header-description">Empieza por las investigaciones destacadas o abre el mapa completo de temas publicados y previstos.</p></header><ol class="topic-list">{featuredConcerns.map((item) => <li><a href={`/preocupaciones/${item.slug}`}><div><h3>{item.title}</h3><p>{item.short}</p></div><span class="topic-arrow" aria-hidden="true">↗</span></a></li>)}</ol><p style="margin-top:28px"><ActionLink href="/investigaciones" label={`Ver las ${concerns.length} investigaciones y el mapa completo`} /></p></section>
</BaseLayout>
<style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout description="Comprueba afirmaciones sobre España con datos públicos, contexto y fuentes originales.">
  <main class="homepage" id="comprobar">
    <section class="homepage-hero" aria-labelledby="checker-title">
      <div class="hero-copy"><p class="eyebrow">Comprobar una afirmación</p><h1 id="checker-title">¿De qué estáis<br /><em>discutiendo?</em></h1><p>Pega una frase, un titular o un mensaje que esté circulando. Lo convertimos en una comprobación breve, comprensible y fácil de compartir.</p></div>
      <div class="hero-checker"><div class="checker-heading"><p class="eyebrow">Empieza aquí</p><span>Texto · enlace · captura · audio</span></div>
        <form class="conversation-form" id="conversation-form" role="search"><label for="conversation-input">Escribe o pega lo que se ha dicho</label><div class="conversation-input-wrap"><textarea id="conversation-input" name="q" rows="3" maxlength="1200" autocomplete="off" placeholder="“Los inmigrantes crean inseguridad…”" aria-describedby="conversation-help"></textarea><button type="submit">Comprobar <span aria-hidden="true">→</span></button></div><p id="conversation-help" class="conversation-help"><span>Puede ser una frase, un enlace, un titular o un mensaje brusco.</span><span id="conversation-counter" aria-live="polite">0/1200</span></p><div class="conversation-input-actions" data-media-dropzone role="group" aria-label="Otras formas de enviar una afirmación"><span>También puedes</span><label for="conversation-file">Subir captura</label><label for="conversation-file">Subir audio</label><input id="conversation-file" name="file" type="file" accept="image/*,audio/*" /></div><p id="conversation-media-help" class="conversation-media-help" aria-live="polite"><span data-file-name>Sin archivo seleccionado.</span> Las capturas y el audio se leen automáticamente.</p></form>
        <div class="recent-checks" id="recent-checks" hidden><div><span>Volver a una comprobación</span><button type="button" data-clear-recent>Limpiar</button></div><div data-recent-list></div></div>
        <div class="conversation-examples" aria-label="Ejemplos"><span>Prueba una frase</span><div class="example-prompts"><button type="button" data-example="Los inmigrantes crean inseguridad">Los inmigrantes crean inseguridad</button><button type="button" data-example="España va fatal">España va fatal</button><button type="button" data-example="La vivienda se ha triplicado">La vivienda se ha triplicado</button><button type="button" data-example="El paro está manipulado">El paro está manipulado</button></div></div>
        <div class="conversation-result" id="conversation-result" role="region" aria-label="Resultado de la comprobación" aria-live="polite"></div>
        <noscript><p>Activa JavaScript para escribir una afirmación. También puedes empezar por <a href="/afirmaciones">las afirmaciones publicadas</a>.</p></noscript>
      </div>
    </section>
    <section class="home-trust" aria-labelledby="home-trust-title"><p class="eyebrow">Cómo respondemos</p><h2 id="home-trust-title">Datos, límites y fuentes.</h2><p>Las respuestas distinguen entre evidencia verificada y generación de IA. Si una afirmación es demasiado amplia o no podemos sostenerla, lo decimos claramente.</p><a href="/metodologia">Conoce el método <span aria-hidden="true">→</span></a></section>
  </main>
</BaseLayout>
<script src="../scripts/claim-checker.ts"></script>
<style>
.homepage{max-width:1240px;margin:auto}.homepage-hero{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(35px,7vw,100px);padding:clamp(60px,10vw,130px) 24px 80px}.hero-copy h1{font:400 clamp(3.6rem,8vw,7.8rem)/.86 var(--serif);letter-spacing:-.07em;margin:20px 0 28px}.hero-copy>p:not(.eyebrow){font:1.1rem/1.45 var(--serif);max-width:500px;color:var(--muted)}.checker-heading{display:flex;justify-content:space-between;gap:12px;align-items:baseline;border-bottom:1px solid var(--ink);padding-bottom:12px}.checker-heading span,.conversation-help,.conversation-media-help,.recent-checks,.conversation-examples{font:.68rem/1.4 var(--mono);color:var(--muted)}.conversation-form label{display:block;font:600 .7rem var(--mono);text-transform:uppercase;margin:20px 0 8px}.conversation-input-wrap{display:grid;grid-template-columns:1fr auto;border:2px solid var(--ink)}.conversation-input-wrap textarea{border:0;background:transparent;resize:vertical;padding:16px;font:1.15rem/1.35 var(--serif);min-width:0}.conversation-input-wrap button{border:0;background:var(--ink);color:var(--paper);padding:0 20px;font:600 .7rem var(--mono);cursor:pointer}.conversation-help{display:flex;justify-content:space-between;gap:12px;margin:8px 0}.conversation-input-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border-block:1px solid var(--line);padding:10px 0;margin-top:12px}.conversation-input-actions label{display:inline-block;margin:0;border:1px solid var(--line);padding:7px 9px;cursor:pointer;color:var(--ink)}.conversation-input-actions input{position:absolute;width:1px;height:1px;opacity:0}.conversation-media-help{margin:9px 0}.conversation-media-help [data-file-name]{color:var(--ink);font-weight:600}.conversation-examples{margin-top:25px}.example-prompts{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);margin-top:9px}.example-prompts button,.recent-checks button{border:0;background:var(--paper-deep);padding:13px;text-align:left;font:1rem/1.1 var(--serif);cursor:pointer}.conversation-result{margin-top:24px}.unified-result-card{border-top:3px solid var(--ink);padding:18px 0}.unified-result-card[data-basis=model]{border-top-color:var(--yellow)}.claim-result-input{font:.7rem/1.4 var(--mono);color:var(--muted);overflow-wrap:anywhere}.claim-result-summary{font:1.3rem/1.3 var(--serif);margin:15px 0}.claim-result-overview{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}.claim-result-overview>div{background:var(--paper-deep);padding:13px}.claim-result-overview span{display:block;font:600 .6rem var(--mono);text-transform:uppercase;color:var(--muted)}.claim-result-overview strong{display:block;margin-top:7px;font:1rem/1.35 var(--sans)}.home-trust{border-top:2px solid var(--ink);padding:45px 24px 80px;max-width:700px}.home-trust h2{font:400 clamp(2.5rem,5vw,5rem)/.9 var(--serif);letter-spacing:-.06em;margin:14px 0}.home-trust p:not(.eyebrow){line-height:1.5;color:var(--muted)}.home-trust a{color:var(--red);font:600 .7rem var(--mono)}
@media(max-width:800px){.homepage-hero{grid-template-columns:1fr;padding-top:55px}.conversation-input-wrap{grid-template-columns:1fr}.conversation-input-wrap button{min-height:50px}.claim-result-overview{grid-template-columns:1fr}}@media(max-width:520px){.homepage-hero,.home-trust{padding-inline:16px}.example-prompts{grid-template-columns:1fr}.checker-heading{display:block}.checker-heading span{display:block;margin-top:6px}}
</style>

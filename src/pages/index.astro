---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicBadge from '../components/TopicBadge.astro';
import ActionLink from '../components/ActionLink.astro';
import { concerns } from '../data/concerns';
import { popularClaims } from '../data/popularClaims';
import { claims } from '../data/claims';
import { conversationMvpClaims } from '../data/conversationMvp';
import { claimIndexEntries } from '../data/claimIndexData';
const featuredConcerns = concerns.filter((item) => ['vivienda','inmigracion','empleo','politica','sanidad'].includes(item.slug));
const publishedClaimCount = claims.filter((item) => item.published).length;
const warehousePrompts = [
  '¿Cómo ha evolucionado la desigualdad de ingresos en España?',
  '¿Cómo ha cambiado el déficit público sobre el PIB?',
  '¿Cómo ha evolucionado la renta mediana de los hogares?',
];
const conversationPayload = JSON.stringify(conversationMvpClaims).replace(/</g, '\\u003c');
const claimIndexPayload = JSON.stringify(claimIndexEntries).replace(/</g, '\\u003c');
---
<BaseLayout description="Comprueba afirmaciones sobre España con datos públicos, contexto y fuentes originales.">
  <section class="homepage-hero" id="comprobar">
    <div class="hero-layout">
      <div class="hero-copy-block"><p class="eyebrow">Comprobar una afirmación</p><h1>¿De qué estáis<br /><em>discutiendo?</em></h1><p class="hero-dek">Pega una frase, un titular o un mensaje que esté circulando. Lo convertimos en una comprobación breve, comprensible y fácil de compartir.</p><ul class="hero-promises" aria-label="Qué encontrarás"><li><span>01</span>Qué parte está respaldada</li><li><span>02</span>Qué no demuestra el dato</li><li><span>03</span>Qué preguntar después</li></ul></div>
      <div class="hero-checker">
        <div class="checker-heading"><p class="eyebrow">Empieza aquí</p><span>Texto · captura · audio</span></div>
        <form class="conversation-form" id="conversation-form" role="search"><label for="conversation-input">Pega lo que se ha dicho</label><div class="conversation-input-wrap"><textarea id="conversation-input" name="q" rows="3" maxlength="1200" autocomplete="off" placeholder="“Los inmigrantes crean inseguridad…”" aria-describedby="conversation-help"></textarea><button type="submit">Comprobar <span aria-hidden="true">→</span></button></div><p id="conversation-help" class="conversation-help"><span>Escríbelo como lo has oído. No hace falta que sea preciso ni académico.</span><span id="conversation-counter" aria-live="polite">0/1200</span></p><label class="conversation-media" for="conversation-file"><span data-file-name>Añadir captura o audio</span><input id="conversation-file" name="file" type="file" accept="image/*,audio/*" /></label><p id="conversation-media-help" class="conversation-media-help" aria-live="polite">Al elegir una captura o un audio, se enviará automáticamente.</p></form>
        <div class="conversation-examples" aria-label="Afirmaciones frecuentes"><div class="examples-heading"><span>Prueba una conversación frecuente</span><a href="/afirmaciones">Ver todas <span aria-hidden="true">→</span></a></div><div class="example-filters" role="group" aria-label="Filtrar afirmaciones frecuentes"><button type="button" class="example-filter is-selected" data-example-filter="all" aria-pressed="true">Todas</button><button type="button" class="example-filter" data-example-filter="vivienda" aria-pressed="false">Vivienda</button><button type="button" class="example-filter" data-example-filter="empleo" aria-pressed="false">Empleo</button><button type="button" class="example-filter" data-example-filter="inmigracion" aria-pressed="false">Inmigración</button><button type="button" class="example-filter" data-example-filter="economia" aria-pressed="false">Economía</button><button type="button" class="example-filter" data-example-filter="sanidad" aria-pressed="false">Sanidad</button><button type="button" class="example-filter" data-example-filter="impuestos" aria-pressed="false">Impuestos</button><button type="button" class="example-filter" data-example-filter="desigualdad" aria-pressed="false">Desigualdad</button></div><div class="example-prompts">{conversationMvpClaims.map((item, index) => <button type="button" data-example={item.prompt} data-example-topic={item.topicSlug} hidden={index >= 8}>{item.prompt}</button>)}</div><button type="button" class="example-more" data-example-more aria-expanded="false">Ver más afirmaciones <span aria-hidden="true">＋</span></button><div class="warehouse-prompts" aria-label="Preguntas con datos actualizados"><span>Prueba también con datos actualizados</span><div>{warehousePrompts.map((prompt) => <button type="button" data-example={prompt} data-example-source="warehouse">{prompt}</button>)}</div></div></div>
        <div class="conversation-result" id="conversation-result" aria-live="polite"></div>
        <noscript><p class="conversation-noscript">Activa JavaScript para escribir una afirmación. También puedes empezar por <a href="/afirmaciones">las afirmaciones publicadas</a>.</p></noscript>
      </div>
    </div>
  </section>
  <section id="afirmaciones" class="popular-home"><header class="section-header section-header-split"><div><p class="eyebrow">Preguntas que aparecen cada día</p><h2>Lo que se está<br /><em>discutiendo.</em></h2></div><p class="section-header-description">Hay {publishedClaimCount} afirmaciones publicadas. Empieza por una pregunta frecuente o escribe la tuya arriba; cada respuesta distingue datos, límites y contexto.</p></header><div class="popular-grid">{popularClaims.slice(0, 8).map((item) => <a class="popular-card" href={`/afirmaciones/${item.slug}`}><TopicBadge slug={item.topicSlug} compact /><h3>{item.claim.replace(/[“”]/g,'')}</h3><span class="card-arrow">Ver datos <span aria-hidden="true">→</span></span></a>)}</div><div id="dynamic-popular-claims" class="dynamic-popular" hidden aria-live="polite"></div><ActionLink href="/afirmaciones" label={`Ver las ${publishedClaimCount} afirmaciones publicadas`} /></section>
  <section class="home-how" aria-labelledby="home-how-title"><div><p class="eyebrow">Cómo funciona</p><h2 id="home-how-title">Una respuesta útil<br /><em>en tres pasos.</em></h2></div><ol><li><span>01</span><strong>Separamos la frase</strong><p>Distinguimos hechos, causas, opiniones y lo que todavía es demasiado ambiguo.</p></li><li><span>02</span><strong>Buscamos el dato adecuado</strong><p>La fuente, la fecha, el lugar y la población van unidos a cada cifra.</p></li><li><span>03</span><strong>Te damos una forma de decirlo</strong><p>Una respuesta breve para la conversación y un camino claro hacia las fuentes.</p></li></ol></section>
  <section id="temas" class="topics-home"><header class="section-header section-header-split"><div><p class="eyebrow">Investigaciones en profundidad</p><h2>Los problemas<br /><em>de fondo.</em></h2></div><p class="section-header-description">Empieza por las investigaciones destacadas o abre el mapa completo de temas publicados y previstos.</p></header><ol class="topic-list">{featuredConcerns.map((item) => <li><a href={`/preocupaciones/${item.slug}`}><div><h3>{item.title}</h3><p>{item.short}</p></div><span class="topic-arrow" aria-hidden="true">↗</span></a></li>)}</ol><p style="margin-top:28px"><ActionLink href="/investigaciones" label={`Ver las ${concerns.length} investigaciones y el mapa completo`} /></p></section>
</BaseLayout>
<style>
  .claim-plan-excerpt{grid-column:1/-1;background:var(--paper-deep)}.claim-plan-excerpt blockquote{margin:12px 0 8px;padding:12px 14px;border-left:3px solid var(--red);font:1rem/1.4 var(--serif)}.claim-plan-excerpt small{display:block;color:var(--muted);font:.68rem/1.35 var(--mono)}
</style>
<style>
  .claim-plan-chart-svg{display:block;width:100%;height:auto;min-height:190px;margin-top:14px;overflow:visible}
  .claim-plan-chart-svg text{font:10px var(--mono);fill:var(--muted)}
  .claim-chart-grid{stroke:var(--line);stroke-width:1}
  .claim-chart-axis-label{font-size:10px}
  .claim-chart-series{fill:none;stroke:var(--red);stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
  .claim-chart-point{fill:var(--paper);stroke:var(--red);stroke-width:3}
  .claim-chart-bar{fill:var(--red);opacity:.82}
  .claim-chart-bar:hover{opacity:1}
  .claim-chart-baseline{stroke:var(--ink);stroke-width:1}
  .claim-chart-data{margin-top:8px;border-top:1px solid var(--line)}
  .claim-chart-data summary{cursor:pointer;padding:9px 0;font:600 .62rem var(--mono);color:var(--red)}
  .claim-chart-data table{width:100%;border-collapse:collapse;font:.68rem var(--mono)}
  .claim-chart-data th,.claim-chart-data td{text-align:left;padding:7px 0;border-top:1px solid var(--line)}
  .claim-chart-data td{text-align:right}
  @media(max-width:650px){.claim-plan-chart-svg{min-height:180px}.claim-chart-axis-label{font-size:9px}}
</style>
<style>
  .claim-result-short-answer{background:var(--yellow);padding:16px 18px;margin:20px 0 4px}.claim-result-short-answer p{font:1.18rem/1.35 var(--serif);margin:9px 0 13px;max-width:700px}.claim-result-short-answer button{border:1px solid var(--ink);background:transparent;padding:8px 11px;font:600 .62rem var(--mono);cursor:pointer}.claim-result-short-answer button:hover{background:var(--ink);color:var(--paper)}.claim-result-overview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);margin:14px 0 4px}.claim-result-overview>div{background:var(--paper-deep);padding:14px 16px;min-width:0}.claim-result-overview span{display:block;font:600 .59rem var(--mono);text-transform:uppercase;color:var(--muted);margin-bottom:8px}.claim-result-overview strong{display:block;font:1rem/1.18 var(--serif);font-weight:400}.claim-result-card[data-state=draft] .claim-result-overview>div:first-child,.claim-result-card[data-state=uncovered] .claim-result-overview>div:first-child{border-left:3px solid var(--yellow)}.claim-result-card[data-state=published] .claim-result-overview>div:first-child{border-left:3px solid #247044}.claim-result-details{grid-column:1/-1;border-top:1px solid var(--line);margin-top:8px}.claim-result-details summary{display:flex;align-items:baseline;justify-content:space-between;gap:16px;cursor:pointer;padding:14px 0;font:600 .68rem var(--mono);list-style:none}.claim-result-details summary::-webkit-details-marker{display:none}.claim-result-details summary:after{content:'＋';color:var(--red);font-size:1rem}.claim-result-details[open] summary:after{content:'−'}.claim-result-details summary small{margin-left:auto;color:var(--muted);font:600 .58rem var(--mono);text-transform:uppercase}.claim-result-secondary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding-bottom:8px}.claim-result-secondary>div{background:var(--paper-deep)}
  @media(max-width:700px){.claim-result-overview{grid-template-columns:1fr}.claim-result-details summary{display:grid;grid-template-columns:1fr auto;gap:5px}.claim-result-details summary small{grid-column:1;margin:0}.claim-result-secondary{grid-template-columns:1fr}}
</style>
<style>
  #conversation-result{max-width:820px}
  .claim-result-top>div{display:flex;align-items:baseline;flex-wrap:wrap;gap:10px}
  .claim-result-state{font:600 .58rem var(--mono);text-transform:uppercase;color:var(--muted)}
  .claim-result-summary{font-size:1.08rem!important;max-width:700px!important}
  .claim-plan-blocks{background:transparent;gap:12px;margin:24px 0}
  .claim-plan-blocks>div{border:1px solid var(--line);border-top:2px solid var(--ink);padding:20px;min-height:0}
  .claim-plan-card{min-height:150px!important}
  .claim-plan-confirmed{border-top-color:#247044!important;background:#f0f4ed!important}
  .claim-plan-limit{border-top-color:var(--red)!important;background:#f8ebe6!important}
  .claim-plan-limit ul{margin-top:14px}
  .claim-plan-reply{background:var(--ink)!important;color:var(--paper);border-color:var(--ink)!important}
  .claim-plan-reply .clarification-label{color:var(--yellow)}
  .claim-plan-reply p{font-size:1.3rem!important;line-height:1.25!important}
  .claim-plan-reply button{border-color:var(--paper);color:var(--paper)}
  .claim-plan-block-evidence{border-top:0;margin-top:14px;padding-top:0;text-transform:none;font-size:.58rem}
  .claim-plan-source-links{background:var(--paper-deep);padding:16px;border-top:0;margin-top:20px}
  .claim-plan-source-links .clarification-label{margin-bottom:4px}
  @media(max-width:650px){.claim-result-top{align-items:flex-start}.claim-result-top>div{display:block}.claim-result-state{display:block;margin-top:6px}.claim-plan-card{min-height:0!important}.claim-plan-reply p{font-size:1.15rem!important}}
</style>
<style>
  .homepage-hero{min-height:0!important;padding-top:clamp(70px,9vw,120px)!important;padding-bottom:clamp(55px,7vw,90px)!important}
  @media(max-width:700px){.homepage-hero{min-height:0!important;padding-top:65px!important}}
</style>
<style>
  .homepage-hero{min-height:0;padding:clamp(70px,9vw,120px) clamp(20px,7vw,110px) clamp(55px,7vw,90px);background:var(--paper);}
  .hero-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr);gap:clamp(40px,8vw,120px);align-items:start;max-width:1300px;margin:0 auto}
  .hero-copy-block{padding-top:10px}.hero-copy-block h1{max-width:760px}.hero-dek{font:1.25rem/1.35 var(--serif);max-width:430px;margin:34px 0 0;color:var(--muted)}
  .hero-checker{border-top:2px solid var(--ink);padding-top:18px;margin-top:7px}.conversation-form label{letter-spacing:.02em}.conversation-input-wrap{display:grid;grid-template-columns:minmax(0,1fr) auto;border:2px solid var(--ink);background:var(--paper)}.conversation-form textarea{min-width:0;resize:vertical;border:0;background:transparent;padding:15px 16px;outline:0;font:1.05rem/1.4 var(--sans)}.conversation-form textarea:focus{box-shadow:inset 0 0 0 2px var(--focus)}.conversation-form button{min-width:135px}.conversation-help{font:.72rem/1.4 var(--mono)!important;color:var(--muted);margin:10px 0 0!important}.conversation-media{width:max-content;max-width:100%;border:1px solid var(--line);padding:8px 10px;margin-top:16px!important}.conversation-media:hover{border-color:var(--ink);color:var(--ink)}.conversation-media:after{display:none}.conversation-media input{width:1px;height:1px}.conversation-examples{margin-top:24px}.conversation-examples>span{width:100%;margin-bottom:2px}.conversation-examples button{background:var(--paper-deep);border-color:var(--line);border-radius:999px;padding:8px 11px}.conversation-examples button:hover{background:var(--yellow)}.conversation-result{margin-top:32px}.home-how{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px;padding:clamp(60px,8vw,100px) clamp(20px,7vw,110px);background:var(--paper-deep);border-bottom:1px solid var(--line)}.home-how h2{font:400 clamp(2.7rem,5vw,5rem)/.88 var(--serif);letter-spacing:-.065em;margin:0}.home-how ol{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);list-style:none;padding:0;margin:0}.home-how li{background:var(--paper);padding:20px;min-height:190px}.home-how li span{font:600 .65rem var(--mono);color:var(--red)}.home-how li strong{display:block;font:1.35rem/1 var(--serif);margin:28px 0 12px}.home-how li p{font-size:.82rem;line-height:1.45;color:var(--muted);margin:0}.claim-result-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.claim-result-actions button{border:1px solid var(--ink);background:transparent;padding:9px 12px;font:600 .64rem var(--mono);cursor:pointer}.claim-result-actions button:hover{background:var(--ink);color:var(--paper)}.claim-result-actions button[data-new-check]{background:var(--ink);color:var(--paper)}.claim-result-actions button[data-new-check]:hover{background:var(--red);border-color:var(--red)}.claim-result-status{border-left:3px solid var(--yellow);padding-left:10px}.claim-result-card[data-state=uncovered]{border-top-color:var(--yellow)}.claim-result-card[data-state=unavailable]{border-top-color:var(--muted)}.claim-result-card[data-state=draft] .claim-assessment{border-color:#9a6511;color:#8b5b0a}.claim-result-card[data-state=related] .claim-assessment{border-color:var(--muted);color:var(--muted)}
  @media(max-width:900px){.hero-layout{grid-template-columns:1fr;gap:45px}.hero-checker{margin-top:0}.home-how{grid-template-columns:1fr;gap:30px}}
  @media(max-width:700px){.homepage-hero{padding-top:65px}.hero-copy-block h1{font-size:clamp(3.8rem,17vw,5.4rem)}.hero-dek{font-size:1.1rem;margin-top:25px}.conversation-input-wrap{grid-template-columns:1fr}.conversation-form button{padding:14px}.home-how{padding-top:65px;padding-bottom:65px}.home-how ol{grid-template-columns:1fr}.home-how li{min-height:0}.popular-home{padding-top:65px;padding-bottom:65px}}
</style>
<style>
  .claim-result-enrichment{display:flex;align-items:flex-start;gap:10px;border-top:1px solid var(--line);margin-top:20px;padding:14px 0 2px;font:.7rem/1.4 var(--mono);color:var(--muted)}.claim-result-enrichment>div{display:grid;gap:2px}.claim-result-enrichment strong{font:600 .62rem var(--mono);text-transform:uppercase;color:var(--ink)}.claim-result-enrichment-dot{width:8px;height:8px;border-radius:50%;margin-top:4px;background:var(--yellow);box-shadow:0 0 0 4px color-mix(in srgb,var(--yellow) 25%,transparent)}.claim-result-enrichment[data-status-state=unavailable] .claim-result-enrichment-dot{background:var(--muted);box-shadow:none}.claim-result-enrichment[data-status-state=slow] .claim-result-enrichment-dot{background:var(--red);box-shadow:none}
  .warehouse-prompts{border-top:1px solid var(--line);margin-top:18px;padding-top:15px}.warehouse-prompts>span{display:block;font:600 .6rem var(--mono);text-transform:uppercase;color:var(--red);margin-bottom:9px}.warehouse-prompts>div{display:flex;flex-wrap:wrap;gap:6px}.warehouse-prompts button{background:var(--paper)!important;border-color:var(--ink)!important}.warehouse-prompts button:hover{background:var(--yellow)!important}
</style>
<script is:inline type="application/json" id="conversation-mvp-data" set:html={conversationPayload}></script>
<script is:inline type="application/json" id="claim-index-data" data-advanced="true" set:html={claimIndexPayload}></script>
<script src="../scripts/claim-input.ts"></script>
<script src="../scripts/popular-claims.ts"></script>
<style>

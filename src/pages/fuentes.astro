---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sourceRecords } from '../data/registry';
import { sourceTypeLabel } from '../data/sourceTitle';
const sources = [...sourceRecords].filter((source) => source.url).sort((a, b) => a.title.localeCompare(b.title, 'es'));
---
<BaseLayout title="Fuentes — El país está fatal"><article class="prose sources-page"><p class="eyebrow">Fuentes</p><h1>Todo lo que<br /><em>puedes comprobar.</em></h1><p class="lead">Este registro reúne las fuentes enlazadas a nuestras fichas y evidencias. Puedes buscar por título, tipo o fecha y abrir siempre el documento original.</p><div class="source-summary"><strong>{sources.length}</strong><span>fuentes registradas en el conocimiento publicado</span><a href="/afirmaciones">Ver fichas publicadas <span aria-hidden="true">→</span></a></div><label class="source-search-label" for="source-search">Buscar una fuente</label><input id="source-search" class="source-search" type="search" placeholder="INE, BOE, vivienda, 2024…" autocomplete="off" /><p id="source-status" class="source-status" aria-live="polite">{sources.length} fuentes visibles</p><ol id="source-list">{sources.map((source, i) => <li data-source-card data-search={`${source.title} ${source.type} ${source.date}`}><span>{String(i+1).padStart(2,'0')}</span><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.title}</strong><small>{sourceTypeLabel(source.type)} · {source.date}</small></a></li>)}</ol></article><script is:inline>
    const sourceInput=document.querySelector('#source-search');const sourceStatus=document.querySelector('#source-status');const sourceCards=[...document.querySelectorAll('[data-source-card]')];
    const sourceNormalise=(value)=>value.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
    const renderSourceFilter=()=>{const query=sourceNormalise(sourceInput?.value||'').trim();let visible=0;sourceCards.forEach((card)=>{const matches=!query||sourceNormalise(card.dataset.search||'').includes(query);card.hidden=!matches;if(matches)visible+=1;});if(sourceStatus)sourceStatus.textContent=`${visible} fuente${visible===1?'':'s'} visible${visible===1?'':'s'}`;};
    sourceInput?.addEventListener('input',renderSourceFilter);renderSourceFilter();
  </script></BaseLayout>
<style>
  .source-summary{display:grid;grid-template-columns:auto 1fr auto;gap:12px 16px;align-items:center;border-top:1px solid var(--ink);border-bottom:1px solid var(--line);padding:18px 0;margin:40px 0 30px}.source-summary>strong{font:2.2rem/1 var(--serif)}.source-summary>span{color:var(--muted);font:.72rem/1.4 var(--mono)}.source-summary>a{font:600 .66rem var(--mono);text-decoration:underline}.source-summary>a span{color:var(--red);text-decoration:none;margin-left:6px}.source-search-label{display:block;font:600 .66rem var(--mono);text-transform:uppercase;margin:24px 0 8px}.source-search{display:block;width:min(100%,640px);border:1px solid var(--ink);background:transparent;padding:13px 14px;font:1rem var(--serif)}.source-search:focus{outline:2px solid var(--red);outline-offset:2px}.source-status{color:var(--muted);font:.68rem var(--mono);margin:10px 0 20px}.sources-page ol{list-style:none;padding:0;margin:0}.sources-page li{display:grid;grid-template-columns:45px 1fr;gap:12px;border-top:1px solid var(--line);padding:18px 0}.sources-page li[hidden]{display:none}.sources-page li>span{font:600 .65rem var(--mono);color:var(--red)}.sources-page li a{display:block}.sources-page li strong{display:block;font:1.2rem/1.05 var(--serif)}.sources-page li small{display:block;color:var(--muted);font:.68rem var(--mono);margin-top:6px}@media(max-width:650px){.source-summary{grid-template-columns:auto 1fr}.source-summary>a{grid-column:1/-1}.sources-page li{grid-template-columns:32px 1fr}}
</style>

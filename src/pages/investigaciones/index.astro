---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicBadge from '../../components/TopicBadge.astro';
import { concerns } from '../../data/concerns';
import { plannedTopics } from '../../data/content';
---
<BaseLayout title="Investigaciones — El país está fatal" description="Investigaciones y temas previstos para comprobar afirmaciones sobre España.">
  <article class="prose investigations-index">
    <p class="eyebrow">Mapa de temas</p>
    <h1>Investigaciones<br /><em>conectadas.</em></h1>
    <p class="lead">Los claims son la entrada rápida. Las investigaciones explican el sistema completo y reúnen los datos que varias afirmaciones comparten.</p>
    <div class="investigation-index-actions"><a class="primary-index-action" href="/#comprobar">Comprobar una afirmación <span aria-hidden="true">→</span></a><a href="/afirmaciones">Ver afirmaciones publicadas <span aria-hidden="true">→</span></a></div>
    <section>
      <p class="eyebrow">Contexto publicado</p>
      <p class="section-note">Empieza por una afirmación concreta. Abre una investigación cuando quieras entender los datos y las causas que hay detrás.</p>
      <div class="investigation-index-grid">{concerns.map((item) => <a href={`/preocupaciones/${item.slug}`}><TopicBadge slug={item.slug} compact /><h2>{item.title}</h2><small>{item.short}</small><span>Ver investigación →</span></a>)}</div>
    </section>
    <section>
      <details class="planned-disclosure">
        <summary><span class="status-label">En preparación</span><strong>Ver temas que todavía no tienen una ficha completa</strong><span class="planned-toggle" aria-hidden="true"></span></summary>
        <p>Esta lista es una cola de trabajo, no un conjunto de respuestas publicadas. Si no encuentras tu pregunta, vuelve al comprobador para recibir la orientación disponible más cercana.</p>
        <div class="investigation-index-grid planned">{plannedTopics.map((item) => <article id={item.slug}><span class="status-label">En preparación</span><h2>{item.title}</h2><small>{item.claimCount} claims propuestos</small><p>{item.body}</p></article>)}</div>
      </details>
    </section>
  </article>
</BaseLayout>
<style>
  .investigations-index section{margin-top:70px}.section-note{max-width:650px;color:var(--muted);font:.8rem/1.5 var(--mono)}.investigation-index-actions{display:flex;flex-wrap:wrap;gap:10px;margin:35px 0 70px}.investigation-index-actions a{border:1px solid var(--ink);padding:12px 14px;font:600 .68rem var(--mono)}.investigation-index-actions .primary-index-action{background:var(--ink);color:var(--paper)}.investigation-index-actions span{margin-left:8px;color:var(--red)}.investigation-index-actions .primary-index-action span{color:var(--yellow)}.investigation-index-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);margin-top:25px}.investigation-index-grid>a,.investigation-index-grid>article{background:var(--paper);padding:24px;min-height:190px}.investigation-index-grid h2{font:1.8rem/.95 var(--serif);margin:25px 0 10px}.investigation-index-grid small,.investigation-index-grid p{display:block;color:var(--muted);font-size:.8rem;line-height:1.45}.investigation-index-grid span:last-child{display:block;margin-top:24px;font:600 .68rem var(--mono)}.planned article{background:var(--paper-deep)}.status-label{font:600 .62rem var(--mono);color:var(--red);text-transform:uppercase}.planned-disclosure{border-top:1px solid var(--ink);margin-top:25px}.planned-disclosure summary{display:grid;grid-template-columns:160px 1fr 24px;gap:18px;align-items:center;padding:20px 0;cursor:pointer;list-style:none}.planned-disclosure summary::-webkit-details-marker{display:none}.planned-disclosure summary:focus-visible{outline:2px solid var(--red);outline-offset:8px}.planned-disclosure summary strong{font:1.3rem/1 var(--serif)}.planned-toggle::before{content:'+';font:700 1.2rem var(--mono)}.planned-disclosure[open] .planned-toggle::before{content:'−'}.planned-disclosure>p{max-width:620px;color:var(--muted);font:.8rem/1.45 var(--mono)}@media(max-width:700px){.investigation-index-grid{grid-template-columns:1fr}.planned-disclosure summary{grid-template-columns:1fr 22px;gap:6px}.planned-disclosure summary .status-label{grid-column:1/-1}.planned-disclosure summary strong{font-size:1.15rem}}
</style>

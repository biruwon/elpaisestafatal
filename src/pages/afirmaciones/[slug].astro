---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicBadge from '../../components/TopicBadge.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ActionLink from '../../components/ActionLink.astro';
import ClaimActions from '../../components/ClaimActions.astro';
import ClaimEvidenceTrail from '../../components/ClaimEvidenceTrail.astro';
import ClaimSeriesChart from '../../components/ClaimSeriesChart.astro';
import { claims, getClaim, assessmentLabels } from '../../data/claimCatalog';
import { concerns } from '../../data/concerns';
import { getSource } from '../../data/registry';
import { sourceTypeLabel } from '../../data/sourceTitle';

export function getStaticPaths(){
  return claims.filter((claim)=>claim.published).map((item)=>({params:{slug:item.slug}}));
}
const item=getClaim(Astro.params.slug!);
if(!item || !item.published){
  return Astro.redirect('/afirmaciones');
}
const relatedSlugs=new Set(item.relatedSlugs);
const related=claims.filter((claim)=>claim.published&&claim.slug!==item.slug&&(relatedSlugs.has(claim.slug)||claim.topicSlugs.some((slug)=>item.topicSlugs.includes(slug))||claim.keywords.some((keyword)=>item.keywords.includes(keyword)))).slice(0,6);
const concern=item.contextMode === 'direct' ? undefined : concerns.find((entry)=>item.topicSlugs.includes(entry.slug));
const metrics=concern?.dossier.metrics.slice(0,3) ?? [];
const series=concern?.dossier.series;
const hasContextData=metrics.length>0||Boolean(series);
const assessmentTone=item.assessment;
const registrySources=item.sourceRefs.map(getSource).filter((source): source is NonNullable<typeof source> => Boolean(source));
const explicitRelations=[...item.supports.map((slug)=>({label:'Apoya',slug})),...item.contradicts.map((slug)=>({label:'Contradice',slug})),...item.dependsOn.map((slug)=>({label:'Depende de',slug}))];
---
<BaseLayout title={`${item.claim} — El país está fatal`} description={item.shareable} image={`/cards/${item.slug}.png`} pageType="article">
  <article id="claim-top" class="affirmation-page">
    <Breadcrumbs items={[{label:'Afirmaciones',href:'/afirmaciones'},{label:item.claim.replace(/[“”]/g,'')}]}/>
    <header class="affirmation-hero">
      <div class="claim-topics">{item.topicSlugs.map((slug)=><TopicBadge slug={slug}/>)}</div>
      <p class="eyebrow">Afirmación comprobada</p>
      <h1>{item.claim.replace(/[“”]/g,'')}</h1>
      <strong class={`assessment assessment-${assessmentTone}`}>{assessmentLabels[item.assessment]}</strong>
      <div class="claim-meta" aria-label="Información de la ficha"><span>{item.geography} · {item.period}</span><span>Revisada {item.reviewed}</span><span>{item.sourceRefs.length || item.sources.length} fuentes</span></div>
    </header>
    <section id="claim-answer" class="claim-verdict" aria-labelledby="claim-verdict-title"><p class="eyebrow">Respuesta breve</p><h2 id="claim-verdict-title">{item.shareable}</h2><div class="claim-verdict-grid"><div><span>Lo que sabemos</span><p>{item.whatIsTrue}</p></div><div><span>Lo que no permite afirmar</span><p>{item.cannotProve}</p></div><div><span>Dato decisivo</span><p>{item.decisiveEvidence}</p></div></div><a class="claim-verdict-detail" href="#claim-data">Ver explicación y fuentes <span aria-hidden="true">↓</span></a></section>
    <ClaimActions short={item.shareable} context={`${item.whatIsTrue} ${item.whatIsMissing}`} data={`${item.scale} ${item.cannotProve}`} imageHref={`/cards/${item.slug}.png`} />
    <section class="claim-next-check" aria-labelledby="claim-next-check-title"><div><p class="eyebrow">Otra frase en la conversación</p><h2 id="claim-next-check-title">¿Qué más te han dicho sobre este tema?</h2><p>Pégalo tal como te ha llegado y vuelve al comprobador para separar una ficha publicada de una orientación provisional.</p></div><ActionLink href="/#comprobar" label="Comprobar otra frase" variant="button" /></section>
    <details id="claim-data" class="claim-details"><summary>Datos y metodología <span aria-hidden="true">＋</span></summary>
    <section id="claim-data" class="claim-data"><header class="section-header section-header-split"><div><p class="eyebrow">{hasContextData?'La escala en datos':'El dato decisivo'}</p><h2>{hasContextData?<>Entenderlo<br /><em>sin perderse.</em></>:<>La fuente<br /><em>dice esto.</em></>}</h2></div><p class="section-header-description">{hasContextData?'Estos datos sitúan la afirmación en el contexto de su tema. La cifra no sustituye la explicación ni prueba una causa por sí sola.':'No añadimos un gráfico de contexto cuando la afirmación requiere una transacción, una norma o un documento concreto. Aquí queda visible el dato que sí está respaldado.'}</p></header>{hasContextData?<>{metrics.length>0&&<div class="claim-metrics">{metrics.map((metric)=><article><strong>{metric.value}</strong><span>{metric.label}</span></article>)}</div>}{series&&<ClaimSeriesChart id={item.slug} series={series} />}</>:<div class="claim-data-direct">{item.visualType === 'money_flow' && <div class="claim-flow" aria-label={`Flujo documentado: ${item.visualOrigin} a ${item.visualDestination}`}><div><strong>{item.visualOrigin}</strong><span>− {item.visualAmount}</span></div><b aria-hidden="true">↓</b><div><strong>{item.visualDestination}</strong><span>+ {item.visualAmount}</span></div></div>}{item.visualType === 'comparison' && item.visualComparisonLabels?.length && <div class="claim-comparison-visual" aria-label="Comparación documentada"><div class="claim-comparison-grid">{item.visualComparisonLabels.slice(0, 3).map((label,index)=><article><span>{label}</span><strong>{item.visualComparisonValues?.[index] || '—'}</strong></article>)}</div><small>{item.visualComparisonUnit}</small></div>}<p class="eyebrow">Evidencia directa</p><strong>{item.decisiveEvidence}</strong><p>El resto de la interpretación se explica en <a href="#claim-evidence">la evidencia enlazada</a> y en los límites de esta ficha.</p></div>}</section>
    </details>
    <ClaimEvidenceTrail claim={item} />
    <details class="claim-details"><summary>Lo que sabemos y lo que falta <span aria-hidden="true">＋</span></summary><section class="claim-facts"><header class="section-header section-header-left"><p class="eyebrow">La respuesta breve</p><h2>Lo que es cierto<br /><em>y lo que falta.</em></h2></header><div class="fact-grid"><article><p class="eyebrow">Qué es cierto</p><p>{item.whatIsTrue}</p></article><article><p class="eyebrow">Qué falta</p><p>{item.whatIsMissing}</p></article><article><p class="eyebrow">Evidencia decisiva</p><p>{item.decisiveEvidence}</p></article><article><p class="eyebrow">Límite de los datos</p><p>{item.cannotProve}</p></article></div><aside class="key-callout"><p class="eyebrow">La clave</p><strong>Una diferencia en los datos no demuestra por sí sola cuál es la causa.</strong></aside></section></details>
    <details id="claim-context" class="claim-details"><summary>Contexto y límites <span aria-hidden="true">＋</span></summary><section class="claim-context"><header class="section-header section-header-left"><p class="eyebrow">Contexto</p><h2>Causas,<br /><em>límites y cambios.</em></h2></header><div class="context-grid"><article><p class="eyebrow">Por qué circula</p><p>{item.whyItCirculates}</p></article><article><p class="eyebrow">Qué no sabemos</p><p>{item.unknowns}</p></article><article><p class="eyebrow">Qué cambiaría la conclusión</p><p>{item.evidenceCouldChange}</p></article><article><p class="eyebrow">Explicaciones rivales</p>{item.competingExplanations.length?<ul>{item.competingExplanations.map((explanation)=><li>{explanation}</li>)}</ul>:<p>La ficha actual no separa explicaciones rivales adicionales; la investigación completa desarrolla el contexto causal.</p>}</article></div>{explicitRelations.length>0&&<div class="claim-relations"><p class="eyebrow">Relaciones con otras afirmaciones</p>{explicitRelations.map((relation)=><a href={`/afirmaciones/${relation.slug}`}>{relation.label}: {claims.find((claim)=>claim.slug===relation.slug)?.claim.replace(/[“”]/g,'')}</a>)}</div>}</section></details>
    <section class="deep-link"><div><p class="eyebrow">{concern?.investigation?'Investigación completa':'Más contexto'}</p><h2>{concern?.investigation?.title || 'Sigue la evidencia relacionada'}</h2><p>{concern?.investigation?.standfirst || 'Explora los datos y las afirmaciones relacionadas con este tema para ampliar la comprobación sin salir del contexto.'}</p></div><ActionLink href={concern?.investigation ? `/preocupaciones/${concern.slug}` : `/datos/${item.topicSlugs[0]}`} label={concern?.investigation ? 'Leer la investigación completa' : 'Ver datos relacionados'} variant="button" /></section>
    <details id="claim-sources" class="claim-details"><summary>Fuentes originales <span aria-hidden="true">＋</span></summary><section class="claim-sources"><p class="eyebrow">Fuentes y evidencia</p>{registrySources.map((source,index)=><a href={source.url} target="_blank" rel="noreferrer"><span>{String(index+1).padStart(2,'0')}</span><strong>{source.title}</strong><small>{source.date} · {sourceTypeLabel(source.type)} ↗</small></a>)}</section></details>
    {related.length>0&&<details class="claim-details"><summary>Preguntas relacionadas <span aria-hidden="true">＋</span></summary><section class="related-claims"><header class="section-header section-header-left"><p class="eyebrow">Sigue comprobando</p><h2>Preguntas<br /><em>relacionadas.</em></h2></header><div>{related.map((claim,index)=><a class:list={{'featured-next':index===0}} href={`/afirmaciones/${claim.slug}`}><TopicBadge slug={claim.topicSlugs[0]} compact/><strong>{index===0?'Siguiente pregunta · ':''}{claim.claim.replace(/[“”]/g,'')}</strong></a>)}</div></section></details>}
    <script is:inline>
      const expandClaimHash = () => { const hash = location.hash; if (!hash || hash === '#') return; const target = document.getElementById(decodeURIComponent(hash.slice(1))) || document.querySelector(hash); const details = target?.closest('details'); if (details) details.open = true; };
      expandClaimHash();
      window.addEventListener('hashchange', expandClaimHash);
    </script>
  </article>
</BaseLayout>
<style>
  .claim-next-check{display:flex;justify-content:space-between;align-items:center;gap:35px;padding:35px 0;border-top:2px solid var(--ink);border-bottom:1px solid var(--line);margin:35px 0 0}.claim-next-check h2{font:clamp(2rem,4vw,3.7rem)/.92 var(--serif);letter-spacing:-.055em;margin:0 0 12px;max-width:760px}.claim-next-check p:not(.eyebrow){max-width:680px;color:var(--muted);margin:0;font-size:.9rem}@media(max-width:700px){.claim-next-check{display:block}.claim-next-check .action-link{margin-top:24px}}
  .affirmation-page{max-width:1120px;margin:auto;padding:45px 30px 100px}.affirmation-hero{padding:70px 0 55px;border-bottom:1px solid var(--ink)}.claim-topics{display:flex;gap:8px;flex-wrap:wrap}.affirmation-hero h1{font:400 clamp(3.2rem,7vw,7rem)/.86 var(--serif);letter-spacing:-.07em;max-width:1000px;margin:22px 0 30px}.assessment{display:inline-block;padding:9px 13px;background:var(--yellow);font:.7rem var(--mono);text-transform:uppercase}.assessment-false{background:#f1b4aa}.assessment-true,.assessment-mostly-true{background:#cfe5cb}.claim-meta{display:flex;gap:12px 20px;flex-wrap:wrap;color:var(--muted);font:.65rem var(--mono);text-transform:uppercase;margin-top:22px}.claim-meta span+span{border-left:1px solid var(--line);padding-left:20px}.answer-line{font:clamp(1.35rem,2.3vw,2.1rem)/1.15 var(--serif);max-width:760px;margin:35px 0 20px}.learn-meta{display:flex;gap:12px 20px;flex-wrap:wrap;color:var(--muted);font:.65rem var(--mono);text-transform:uppercase}.claim-reading-nav{display:flex;gap:8px;flex-wrap:wrap;padding:14px 0;border-bottom:1px solid var(--line);position:sticky;top:0;background:color-mix(in srgb,var(--paper) 94%,transparent);backdrop-filter:blur(8px);z-index:3}.claim-reading-nav a{display:inline-flex;align-items:center;min-height:44px;border:1px solid var(--ink);padding:9px 11px;font:600 .64rem var(--mono)}.claim-reading-nav a:hover{background:var(--ink);color:var(--paper)}.claim-visual{display:grid;grid-template-columns:1.4fr .6fr;gap:35px;align-items:stretch;margin:55px 0 0;background:var(--ink);color:var(--paper);min-height:330px}.claim-visual-copy{padding:38px;display:flex;flex-direction:column;align-items:flex-start}.claim-visual-copy strong{font:400 clamp(2rem,4vw,4.2rem)/.92 var(--serif);letter-spacing:-.05em;margin:20px 0 auto;max-width:700px}.claim-visual-copy>span{font:.8rem/1.45 var(--sans);color:#d5cec3;max-width:550px}.claim-visual-mark{background:var(--red);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:14px;position:relative;padding:25px}.claim-visual-mark i{display:block;width:75%;height:12px;background:var(--yellow);transform:skewY(-18deg)}.claim-visual-mark i:nth-child(2){width:55%;opacity:.8}.claim-visual-mark i:nth-child(3){width:35%;opacity:.6}.claim-visual-mark b{font:600 .68rem var(--mono);text-transform:uppercase;margin-top:24px}.claim-data,.claim-facts,.claim-context{padding:90px 0 65px;border-bottom:1px solid var(--line)}.claim-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:35px}.claim-metrics article{background:var(--paper-deep);padding:28px}.claim-metrics strong{display:block;font:400 clamp(2.3rem,4vw,4rem)/.9 var(--serif);color:var(--red);letter-spacing:-.06em}.claim-metrics span{display:block;margin-top:12px;font:.72rem/1.3 var(--mono)}.claim-chart{background:var(--paper-deep);padding:25px;margin:28px 0 0}.claim-chart figcaption{display:flex;justify-content:space-between;gap:20px;margin-bottom:25px;font:.72rem var(--mono);text-transform:uppercase}.claim-chart figcaption span{color:var(--muted)}.claim-chart>div{display:grid;grid-template-columns:80px 1fr 55px;gap:12px;align-items:center;margin:12px 0;font:.7rem var(--mono)}.claim-chart i{height:14px;background:#d2c8ba}.claim-chart i b{display:block;height:100%;background:var(--red)}.claim-chart small,.evidence-note{display:block;color:var(--muted);font:.68rem/1.45 var(--mono);margin-top:18px}.fact-grid,.context-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line)}.fact-grid article,.context-grid article{background:var(--paper);padding:28px;min-height:190px}.fact-grid article>p:last-child,.context-grid article>p:last-child{font:1.3rem/1.3 var(--serif)}.context-grid ul{padding-left:18px;line-height:1.5}.key-callout{margin-top:28px;padding:24px;border-left:5px solid var(--red);background:var(--paper-deep)}.key-callout strong{font:1.45rem/1.2 var(--serif)}.deep-link{display:flex;justify-content:space-between;gap:35px;align-items:center;padding:35px 0;border-top:2px solid var(--ink);border-bottom:1px solid var(--line);margin-top:40px}.deep-link h2{font:2.2rem/.95 var(--serif);margin:0 0 10px}.deep-link p:not(.eyebrow){max-width:650px;color:var(--muted);margin:0}.claim-sources{padding:70px 0;border-top:1px solid var(--line);margin-top:55px}.claim-sources>a{display:grid;grid-template-columns:40px 1fr;gap:4px 12px;padding:15px 0;border-bottom:1px solid var(--line)}.claim-sources>a>span{font:.65rem var(--mono);color:var(--red)}.claim-sources strong{font:1.15rem var(--serif)}.claim-sources small{grid-column:2;color:var(--muted);font-size:.68rem}.related-claims{border-top:1px solid var(--line);padding-top:70px;margin-top:20px}.related-claims>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line)}.related-claims a{background:var(--paper);padding:22px;min-height:140px}.related-claims a:hover{background:var(--paper-deep)}.related-claims a.featured-next{grid-column:1/-1;background:var(--paper-deep)}.related-claims strong{display:block;font:1.3rem/1 var(--serif);margin-top:22px}@media(max-width:700px){.affirmation-page{padding:30px 20px 70px}.claim-visual{grid-template-columns:1fr;margin-left:-20px;margin-right:-20px}.claim-visual-copy{padding:28px 20px;min-height:310px}.claim-visual-copy strong{font-size:2.5rem}.claim-visual-mark{min-height:150px}.claim-data,.claim-facts,.claim-context{padding:65px 0 45px}.claim-metrics,.fact-grid,.context-grid,.related-claims>div{grid-template-columns:1fr}.claim-chart>div{grid-template-columns:60px 1fr 45px}.deep-link{display:block}.deep-link .action-link{margin-top:24px}.claim-sources>a{grid-template-columns:28px 1fr}.claim-sources small{grid-column:2}.claim-meta{gap:8px 12px}.claim-meta span+span{border-left:0;padding-left:0}}
  .claim-data-direct{margin-top:35px;padding:32px;background:var(--paper-deep);border-left:5px solid var(--red)}.claim-data-direct strong{display:block;font:400 clamp(1.8rem,3.4vw,3.4rem)/1 var(--serif);letter-spacing:-.04em;max-width:820px}.claim-data-direct p:last-child{margin:20px 0 0;color:var(--muted);font:.78rem/1.5 var(--mono)}.claim-data-direct a{text-decoration:underline;text-underline-offset:3px}.claim-flow{display:grid;gap:10px;margin-bottom:32px}.claim-flow>div{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding:20px;background:var(--paper)}.claim-flow strong{font:1.1rem/1.15 var(--serif);max-width:620px}.claim-flow span{font:.68rem var(--mono);color:var(--red);white-space:nowrap}.claim-flow>b{text-align:center;color:var(--red);font:1.4rem var(--mono)}.claim-comparison-visual{margin-bottom:32px}.claim-comparison-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line)}.claim-comparison-grid article{background:var(--paper);padding:26px}.claim-comparison-grid span{display:block;font:.68rem var(--mono);text-transform:uppercase;color:var(--muted)}.claim-comparison-grid strong{display:block;margin-top:18px;color:var(--red);font:400 clamp(2rem,4vw,4rem)/.9 var(--serif);letter-spacing:-.06em}.claim-comparison-visual small{display:block;margin-top:12px;color:var(--muted);font:.68rem/1.4 var(--mono)}.evidence-list{margin-top:35px;padding-top:25px;border-top:1px solid var(--line)}.evidence-list article{padding:16px 0;border-bottom:1px solid var(--line)}.evidence-list article strong,.evidence-list article span{display:block;font:.68rem var(--mono)}.evidence-list article span{color:var(--muted);margin-top:5px}.evidence-list article p{margin:10px 0 0;color:var(--muted);font-size:.85rem}.claim-relations{margin-top:30px;padding:25px;background:var(--paper-deep);display:grid;gap:8px}.claim-relations a{font:1rem var(--serif)}
  @media(max-width:700px){.claim-flow>div{grid-template-columns:1fr}.claim-flow span{white-space:normal}.claim-comparison-grid{grid-template-columns:1fr}}
  .claim-verdict{padding:45px 0 0;border-bottom:1px solid var(--line)}.claim-verdict h2{font:400 clamp(2rem,4.5vw,4.5rem)/.95 var(--serif);letter-spacing:-.055em;max-width:850px;margin:12px 0 28px}.claim-verdict-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}.claim-verdict-grid>div{background:var(--paper-deep);padding:18px;min-height:150px}.claim-verdict-grid span{display:block;font:600 .62rem/1.3 var(--mono);text-transform:uppercase;color:var(--muted)}.claim-verdict-grid p{font:1.05rem/1.35 var(--serif);margin:18px 0 0}.claim-verdict-detail{display:inline-flex;align-items:center;gap:10px;min-height:44px;margin:22px 0 32px;color:var(--red);font:600 .68rem var(--mono);text-transform:uppercase}.claim-verdict-detail span{font-size:1rem}.claim-details{border-bottom:1px solid var(--line);scroll-margin-top:70px}.claim-details>summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:64px;padding:10px 0;cursor:pointer;list-style:none;font:600 .7rem var(--mono);text-transform:uppercase}.claim-details>summary::-webkit-details-marker{display:none}.claim-details>summary span{color:var(--red);font-size:1.1rem}.claim-details[open]>summary span{transform:rotate(45deg)}.claim-details .claim-data,.claim-details .claim-evidence,.claim-details .claim-facts,.claim-details .claim-context,.claim-details .claim-sources,.claim-details .related-claims{padding-top:35px;margin-top:0;border-bottom:0}.claim-details .claim-sources{margin-top:0}.claim-details .related-claims{margin-top:0}
  @media(max-width:700px){.claim-verdict{padding-top:35px}.claim-verdict h2{font-size:2.35rem}.claim-verdict-grid{grid-template-columns:1fr}.claim-verdict-grid>div{min-height:0}.claim-verdict-grid p{margin-top:10px}.claim-details>summary{min-height:56px}.claim-details .claim-data,.claim-details .claim-evidence,.claim-details .claim-facts,.claim-details .claim-context,.claim-details .claim-sources,.claim-details .related-claims{padding-top:25px}}
</style>

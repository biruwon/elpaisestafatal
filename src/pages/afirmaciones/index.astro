---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicBadge from '../../components/TopicBadge.astro';
import { claims, assessmentLabels } from '../../data/claims';
const publishedClaims = claims.filter((claim) => claim.published);
const topicCount = new Set(publishedClaims.flatMap((claim) => claim.topicSlugs)).size;
---
<BaseLayout title="Afirmaciones — El país está fatal" description="Afirmaciones sobre España comprobadas con contexto y fuentes originales."><article class="prose affirmation-index"><p class="eyebrow">Preguntas comprobadas</p><h1>Afirmaciones,<br /><em>puestas a prueba.</em></h1><p class="lead">Escribe una frase como te la han enviado. Aquí encontrarás respuestas breves, datos decisivos y los límites de lo que se puede afirmar.</p><div class="affirmation-index-intro"><div><strong>{publishedClaims.length}</strong><span>fichas publicadas</span></div><div><strong>{topicCount}</strong><span>temas conectados</span></div><a href="/#comprobar">Comprobar otra frase <span aria-hidden="true">↗</span></a></div><div class="affirmation-grid">{publishedClaims.map((item) => <a href={`/afirmaciones/${item.slug}`}><TopicBadge slug={item.topicSlug} compact /><h2>{item.claim.replace(/[“”]/g,'')}</h2><span>{assessmentLabels[item.assessment]} · Ver ficha →</span></a>)}</div></article></BaseLayout>
<style>.affirmation-index-intro{display:grid;grid-template-columns:repeat(2,1fr) 1.6fr;gap:1px;background:var(--line);margin-top:45px}.affirmation-index-intro>div,.affirmation-index-intro>a{background:var(--paper-deep);padding:20px}.affirmation-index-intro strong,.affirmation-index-intro span{display:block}.affirmation-index-intro strong{font:400 2.8rem/.9 var(--serif);color:var(--red)}.affirmation-index-intro span{font:.68rem/1.3 var(--mono);margin-top:10px;text-transform:uppercase}.affirmation-index-intro>a{display:flex;justify-content:space-between;align-items:center;font:1.15rem var(--serif)}.affirmation-index-intro>a:hover{background:var(--ink);color:var(--paper)}.affirmation-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);margin-top:35px}.affirmation-grid a{background:var(--paper);padding:24px;min-height:190px}.affirmation-grid a:hover{background:var(--paper-deep)}.affirmation-grid h2{font:400 1.7rem/1 var(--serif);letter-spacing:-.04em;margin:28px 0}.affirmation-grid a>span:last-child{font:600 .65rem var(--mono);color:var(--red)}@media(max-width:650px){.affirmation-index-intro{grid-template-columns:1fr 1fr}.affirmation-index-intro>a{grid-column:1/-1}.affirmation-grid{grid-template-columns:1fr}}
</style>

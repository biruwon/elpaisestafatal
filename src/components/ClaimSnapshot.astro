---
import type { ClaimVerification } from '../data/claimCatalog';

interface Props { claim: ClaimVerification }
const { claim } = Astro.props;
const evidenceLabels = { high: 'Cobertura alta', medium: 'Cobertura suficiente', limited: 'Cobertura limitada', insufficient: 'Faltan datos directos' } as const;
const typeLabels = { descriptive: 'Hecho', comparative: 'Comparación', definition: 'Definición', trend: 'Tendencia', causal: 'Causalidad', predictive: 'Predicción', legal: 'Regla o ley', normative: 'Valor o prioridad', mixed: 'Mezcla de preguntas' } as const;
const shortClaim = claim.claim.replace(/[“”]/g, '');
---

<section id="claim-snapshot" class="claim-snapshot" aria-labelledby="claim-snapshot-title">
  <header class="snapshot-heading">
    <div><p class="eyebrow">Antes de entrar en los datos</p><h2 id="claim-snapshot-title">La respuesta<br /><em>en tres pasos.</em></h2></div>
    <p class="snapshot-intro">No damos por resuelta una frase completa si mezcla un hecho, una causa y una interpretación. Esta ficha separa lo que la evidencia permite decir de lo que todavía no demuestra.</p>
  </header>
  <div class="snapshot-meta" aria-label="Ficha de la comprobación"><span>{evidenceLabels[claim.evidenceStrength]}</span><span>{typeLabels[claim.claimType]}</span><span>{claim.geography} · {claim.period}</span><span>Revisada {claim.reviewed}</span></div>
  <div class="snapshot-grid">
    <article class="snapshot-card snapshot-card-supported"><p class="eyebrow">01 · Sí está respaldado</p><strong>{claim.whatIsTrue}</strong></article>
    <article class="snapshot-card snapshot-card-limited"><p class="eyebrow">02 · No se puede concluir</p><strong>{claim.cannotProve}</strong></article>
    <article class="snapshot-card snapshot-card-next"><p class="eyebrow">03 · Qué faltaría</p><strong>{claim.evidenceCouldChange}</strong></article>
  </div>
  <p class="snapshot-claim"><span>La frase analizada</span> “{shortClaim}”</p>
</section>

<style>
  .claim-snapshot{padding:70px 0 55px;border-bottom:1px solid var(--line)}
  .snapshot-heading{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:end}
  .snapshot-heading h2{font:400 clamp(2.4rem,5vw,5rem)/.88 var(--serif);letter-spacing:-.06em;margin:16px 0 0}
  .snapshot-intro{max-width:470px;margin:0;color:var(--muted);font-size:.95rem;line-height:1.45}
  .snapshot-meta{display:flex;gap:8px;flex-wrap:wrap;margin:35px 0 1px}
  .snapshot-meta span{border:1px solid var(--line);padding:9px 11px;font:600 .64rem var(--mono);text-transform:uppercase}
  .snapshot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
  .snapshot-card{background:var(--paper-deep);padding:25px;min-height:225px;border-top:5px solid var(--ink)}
  .snapshot-card-supported{border-top-color:#6e956a}.snapshot-card-limited{border-top-color:var(--red)}.snapshot-card-next{border-top-color:var(--yellow)}
  .snapshot-card strong{display:block;font:400 1.35rem/1.15 var(--serif);margin-top:28px}
  .snapshot-claim{margin:22px 0 0;color:var(--muted);font:.72rem/1.4 var(--mono)}
  .snapshot-claim span{color:var(--ink);font-weight:600;text-transform:uppercase}
  @media(max-width:760px){.snapshot-heading{grid-template-columns:1fr;gap:20px}.snapshot-grid{grid-template-columns:1fr}.snapshot-card{min-height:0}.claim-snapshot{padding:60px 0 45px}}
</style>

---
import type { ClaimVerification } from '../data/claimCatalog';
import { getEvidence, getSource, relationshipGuidance, relationshipReviewPolicy } from '../data/registry';
import { propositions } from '../data/propositions';
import { sourceTypeLabel } from '../data/sourceTitle';

interface Props { claim: ClaimVerification }
const { claim } = Astro.props;
const evidence = claim.evidenceIds.map(getEvidence).filter((item): item is NonNullable<typeof item> => Boolean(item));
const kindLabels: Record<string, string> = {
  'official-report': 'Registro oficial',
  'statistical-series': 'Serie estadística',
  calculation: 'Cálculo reproducible',
  definition: 'Definición',
  legal: 'Referencia legal',
};
const sourceFor = (ids: string[]) => ids.map(getSource).find((source): source is NonNullable<typeof source> => Boolean(source));
const uniqueSources = [...new Set(evidence.flatMap((item) => item.sourceIds))].map(getSource).filter((source): source is NonNullable<typeof source> => Boolean(source));
const propositionIds = new Set(claim.propositionIds);
const propositionText = new Map(propositions.map((item) => [item.id, item.text]));
const relationshipLabels: Record<string, string> = {
  supports: 'Apoya la proposición',
  contradicts: 'Contradice la proposición',
  qualifies: 'La matiza',
  context: 'Aporta contexto',
  insufficient: 'No basta para comprobarla',
};
const readableEvidenceSummary = (summary: string) => summary.startsWith('Reusable source evidence.')
  ? 'Este registro aporta datos de contexto relacionados con la afirmación; por sí solo no demuestra la causa.'
  : summary;
---

{evidence.length > 0 && <section id="claim-evidence" class="claim-evidence" aria-labelledby="claim-evidence-title">
  <header class="evidence-heading">
    <div><p class="eyebrow">La base de esta ficha</p><h2 id="claim-evidence-title">Qué hemos<br /><em>utilizado.</em></h2></div>
    <div><p>Estos registros son la evidencia enlazada a esta afirmación. Cada uno mantiene su periodo, territorio y definición para que no se confunda una cifra de contexto con una prueba de causalidad.</p><p class="evidence-review-policy"><strong>Revisión:</strong> {relationshipReviewPolicy.scope === 'source-and-proposition-traceability' ? 'trazabilidad de fuente y proposición' : 'protocolo de revisión'} comprobada por {relationshipReviewPolicy.reviewer === 'maintainer' ? 'el mantenedor' : 'un revisor autorizado'}. {relationshipReviewPolicy.independentReview ? 'Incluye revisión independiente.' : 'No es una revisión independiente.'}</p></div>
  </header>
  <div class="evidence-trail-grid">
    {evidence.map((item, index) => {
      const source = sourceFor(item.sourceIds);
      const reviewedAt = item.relationships
        .filter((link) => propositionIds.has(link.propositionId) && link.reviewStatus === 'reviewed' && link.reviewedAt)
        .map((link) => link.reviewedAt as string)
        .sort()
        .at(-1);
      return <article class="evidence-trail-card">
        <div class="evidence-trail-top"><span>{String(index + 1).padStart(2, '0')}</span><strong>{kindLabels[item.kind] || 'Registro de evidencia'}</strong></div>
        <h3>{source?.title || 'Fuente pública vinculada'}</h3>
        <dl><div><dt>Periodo</dt><dd>{item.period || 'No indicado'}</dd></div><div><dt>Ámbito</dt><dd>{item.geography || 'No indicado'}</dd></div><div><dt>Unidad</dt><dd>{item.unit || 'No indicada'}</dd></div>{source?.date && <div><dt>Fuente fechada</dt><dd>{source.date}</dd></div>}{reviewedAt && <div><dt>Vínculo revisado</dt><dd>{reviewedAt}</dd></div>}</dl>
        <p class="evidence-label">Qué establece este registro</p>
        <p class="evidence-finding">{readableEvidenceSummary(item.summary)}</p>
        {item.limitation && <p class="evidence-limit"><strong>Límite:</strong> {item.limitation}</p>}
        {item.relationships.filter((link) => propositionIds.has(link.propositionId)).map((link) => <div class="evidence-relation-wrap"><span class={`evidence-relation evidence-relation-${link.relationship}`}>{relationshipLabels[link.relationship]}</span><details class="evidence-relation-details"><summary>Por qué está vinculado</summary><p><strong>Proposición:</strong> {propositionText.get(link.propositionId) || 'Proposición publicada asociada'}</p><p>{relationshipGuidance[link.relationship]}</p>{link.reviewedAt && <p class="evidence-review-meta"><strong>Revisión del vínculo:</strong> {link.reviewedAt}</p>}</details></div>)}
        {source && <a href={source.url} target="_blank" rel="noreferrer">{sourceTypeLabel(source.type)} · Abrir fuente <span aria-hidden="true">↗</span></a>}
      </article>;
    })}
  </div>
  {uniqueSources.length > 0 && <p class="evidence-source-count">{uniqueSources.length} fuente{uniqueSources.length === 1 ? '' : 's'} original{uniqueSources.length === 1 ? '' : 'es'} enlazada{uniqueSources.length === 1 ? '' : 's'} a {evidence.length} registro{evidence.length === 1 ? '' : 's'} de evidencia.</p>}
</section>}

<style>
  .claim-evidence{padding:85px 0 65px;border-bottom:1px solid var(--line)}
  .evidence-heading{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:end}
  .evidence-heading h2{font:400 clamp(2.4rem,5vw,5rem)/.88 var(--serif);letter-spacing:-.06em;margin:16px 0 0}
  .evidence-heading>p{max-width:470px;color:var(--muted);font-size:.95rem;line-height:1.45;margin:0}
  .evidence-heading>div>p{max-width:470px;color:var(--muted);font-size:.95rem;line-height:1.45;margin:0}.evidence-heading>div>p.evidence-review-policy{font:.65rem/1.45 var(--mono);margin-top:14px;color:var(--ink)}.evidence-review-policy strong{color:var(--red)}
  .evidence-trail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);margin-top:35px}
  .evidence-trail-card{background:var(--paper-deep);padding:23px;min-height:220px}
  .evidence-trail-top{display:flex;justify-content:space-between;gap:12px;color:var(--red);font:600 .62rem var(--mono);text-transform:uppercase}
  .evidence-trail-top strong{color:var(--ink);font-weight:600}
  .evidence-trail-card h3{font:400 1.35rem/1.05 var(--serif);margin:28px 0 20px}
  .evidence-trail-card dl{display:flex;flex-wrap:wrap;gap:12px 20px;margin:0 0 22px}
  .evidence-trail-card dt{font:600 .58rem var(--mono);text-transform:uppercase;color:var(--muted)}
  .evidence-trail-card dd{font:.72rem var(--mono);margin:4px 0 0}
  .evidence-label{font:600 .6rem var(--mono);letter-spacing:.04em;text-transform:uppercase;color:var(--red);margin:0 0 7px}
  .evidence-finding{font:1rem/1.35 var(--serif);margin:0 0 12px}
  .evidence-limit{color:var(--muted);font:.72rem/1.45 var(--mono);margin:0 0 16px}
  .evidence-limit strong{color:var(--ink);font-weight:600}
  .evidence-review-meta{font-size:.64rem!important;color:var(--muted)}
  .evidence-trail-card a{font:600 .65rem var(--mono);color:var(--red)}
  .evidence-trail-card a span{margin-left:5px}
  .evidence-relation-wrap{display:block;margin:0 0 14px}.evidence-relation{display:inline-block;margin:0 6px 0 0;padding:5px 7px;border:1px solid var(--line);font:600 .58rem var(--mono);text-transform:uppercase}
  .evidence-relation-supports{background:#d9ead5}.evidence-relation-contradicts{background:#f1b4aa}.evidence-relation-qualifies,.evidence-relation-insufficient{background:var(--yellow)}.evidence-relation-context{background:var(--paper)}
  .evidence-relation-details{display:inline-block;vertical-align:middle;max-width:100%;font:.68rem/1.4 var(--mono)}.evidence-relation-details summary{display:inline-block;cursor:pointer;color:var(--red);font-weight:600}.evidence-relation-details p{max-width:620px;margin:8px 0 0;padding:9px 10px;background:var(--paper);border-left:2px solid var(--line);color:var(--muted)}.evidence-relation-details p strong{color:var(--ink)}
  .evidence-source-count{color:var(--muted);font:.68rem/1.4 var(--mono);margin:18px 0 0}
  @media(max-width:700px){.evidence-heading{grid-template-columns:1fr;gap:20px}.evidence-trail-grid{grid-template-columns:1fr}.claim-evidence{padding:65px 0 45px}}
</style>

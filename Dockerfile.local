FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-venv && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY scripts ./scripts
COPY src ./src
COPY content ./content
COPY config ./config
COPY migrations ./migrations

ENV NODE_ENV=production
ENV LOCAL_CLASSIFIER_PORT=8789
ENV OLLAMA_ENDPOINT=http://host.docker.internal:11434

EXPOSE 8789
CMD ["node", "scripts/local-claim-service.mjs"]
